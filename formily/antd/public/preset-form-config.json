{
  "form": {
    "labelCol": 6,
    "wrapperCol": 18,
    "layout": "horizontal"
  },
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "姓名",
        "required": true,
        "x-decorator": "FormItem",
        "x-component": "Input",
        "x-component-props": {
          "placeholder": "请输入您的姓名"
        }
      },
      "gender": {
        "type": "string",
        "title": "性别",
        "required": true,
        "x-decorator": "FormItem",
        "x-component": "Select",
        "x-component-props": {
          "placeholder": "请选择性别"
        },
        "enum": "preset:gender"
      },
      "region": {
        "type": "array",
        "title": "所在地区",
        "required": true,
        "x-decorator": "FormItem",
        "x-component": "Cascader",
        "x-component-props": {
          "placeholder": "请选择省市县",
          "changeOnSelect": false,
          "expandTrigger": "hover"
        },
        "enum": "preset:china-regions"
      },
      "education": {
        "type": "string",
        "title": "教育程度",
        "x-decorator": "FormItem",
        "x-component": "Select",
        "x-component-props": {
          "placeholder": "请选择教育程度"
        },
        "enum": "preset:education"
      },
      "occupation": {
        "type": "array",
        "title": "职业",
        "x-decorator": "FormItem",
        "x-component": "Cascader",
        "x-component-props": {
          "placeholder": "请选择职业分类",
          "changeOnSelect": true
        },
        "enum": "preset:occupation"
      },
      "interests": {
        "type": "array",
        "title": "兴趣爱好",
        "x-decorator": "FormItem",
        "x-component": "Checkbox.Group",
        "enum": "preset:interests"
      },
      "phone": {
        "type": "string",
        "title": "手机号码",
        "required": true,
        "x-decorator": "FormItem",
        "x-component": "Input",
        "x-component-props": {
          "placeholder": "请输入手机号码"
        },
        "x-validator": [
          {
            "pattern": "^1[3-9]\\d{9}$",
            "message": "请输入正确的手机号码格式"
          }
        ]
      },
      "email": {
        "type": "string",
        "title": "邮箱",
        "x-decorator": "FormItem",
        "x-component": "Input",
        "x-component-props": {
          "placeholder": "请输入邮箱地址"
        },
        "x-validator": [
          {
            "format": "email",
            "message": "请输入正确的邮箱格式"
          }
        ]
      },
      "description": {
        "type": "string",
        "title": "个人描述",
        "x-decorator": "FormItem",
        "x-component": "Input.TextArea",
        "x-component-props": {
          "placeholder": "请简单介绍一下自己",
          "rows": 4
        }
      }
    }
  }
}
